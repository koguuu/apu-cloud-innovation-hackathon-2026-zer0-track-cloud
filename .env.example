# Copy this file to .env and fill in. NEVER commit .env.
# Everything is optional in dev. In production (APP_ENV=production) both API keys are required.

APP_ENV=dev
INGEST_API_KEY=
DASHBOARD_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Secret salt for hashing student IDs (app/privacy.py). Never share it.
HASH_SALT=

# Gemini (free key from Google AI Studio is enough to start)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Telegram alerts to the admin (bot token from BotFather, chat id of the admin chat)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Detection thresholds (defaults shown)
# LATENCY_BAD_MS=150
# LOSS_BAD_PCT=5
# RSSI_BAD_DBM=-80
# CONGESTION_CLIENTS=150
# BAD_READINGS_TO_TRIP=3
# GOOD_READINGS_TO_RECOVER=3
# UPLINK_FRACTION=0.6

# Google Cloud (later)
GCP_PROJECT_ID=smart-lab-companion
GCP_REGION=asia-southeast1
PUBSUB_TOPIC=campus-events
