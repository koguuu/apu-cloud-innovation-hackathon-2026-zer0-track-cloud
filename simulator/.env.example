# Optional. Copy to simulator/.env (git-ignored) only if you need to change a default.
# The simulator also reads these keys from the repo-root .env. Real environment variables win.

# Where the backend runs
BACKEND_URL=http://localhost:8000
# Same value as the backend's INGEST_API_KEY (leave empty in dev if the backend has none)
INGEST_API_KEY=

# Seconds between readings. 2 means a fault is detected about 4 seconds after it starts.
SIM_TICK_SECONDS=2
# Real seconds for one simulated day (07:00 to 21:00)
SIM_DAY_SECONDS=240
# Simulated hour when the run starts (9.5 = 09:30, close to the morning peak)
SIM_START_HOUR=9.5
# Chance per AP per tick of a single noisy reading (0 turns noise spikes off)
SIM_BLIP_PROB=0.01
# Fixed random seed for repeatable runs (leave empty for random)
SIM_SEED=
